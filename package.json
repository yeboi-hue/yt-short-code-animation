{
  "name": "pyramid-short",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "audio": "python make_audio.py",
    "dev": "remotion studio index.ts",
    "still": "remotion still index.ts PyramidShort out/still.png --frame=700 --scale=0.5 --gl=angle",
    "render": "remotion render index.ts PyramidShort out/pyramid.mp4 --codec h264 --crf 18 --gl=angle",
    "render:ci": "remotion render index.ts PyramidShort out/pyramid.mp4 --codec h264 --crf 18 --gl=swangle --concurrency=3 --timeout=180000"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@remotion/cli": "4.0.290",
    "@remotion/three": "4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/three": "0.175.0",
    "typescript": "5.6.3"
  }
}
